    "CritiqueCategory": {
      "enum": [
        "brand_lock",
        "fact",
        "readability",
        "culture",
        "safety"
      ],
      "title": "CritiqueCategory",
      "type": "string"
    },
    "CritiqueCompleted": {
      "additionalProperties": false,
      "properties": {
        "critique": {
          "$ref": "#/$defs/CritiqueReport"
        },
        "human_revision_count": {
          "maximum": 1,
          "minimum": 0,
          "title": "Human Revision Count",
          "type": "integer"
        },
        "initial_generation_count": {
          "maximum": 1,
          "minimum": 0,
          "title": "Initial Generation Count",
          "type": "integer"
        },
        "reviewed_at": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "failed_final"
          ],
          "title": "Status",
          "type": "string"
        },
        "technical_attempt_count": {
          "minimum": 0,
          "title": "Technical Attempt Count",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "status",
        "critique",
        "initial_generation_count",
        "human_revision_count",
        "technical_attempt_count",
        "reviewed_at"
      ],
      "title": "CritiqueCompleted",
      "type": "object"
    },
    "CritiqueIssue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/CritiqueCategory"
        },
        "code": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "requires_human_review": {
          "default": false,
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/CritiqueSeverity"
        }
      },
      "required": [
        "code",
        "category",
        "severity",
        "message"
      ],
      "title": "CritiqueIssue",
      "type": "object"
    },
    "CritiqueReport": {
      "additionalProperties": false,
      "properties": {
        "brand_lock_preserved": {
          "title": "Brand Lock Preserved",
          "type": "boolean"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CritiqueIssue"
          },
          "maxItems": 32,
          "title": "Issues",
          "type": "array"
        },
        "requires_human_review": {
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "reviewed_at": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "status": {
          "$ref": "#/$defs/CritiqueStatus"
        },
        "warnings": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "brand_lock_preserved",
        "requires_human_review",
        "reviewed_at"
      ],
      "title": "CritiqueReport",
      "type": "object"
    },
    "CritiqueSeverity": {
      "enum": [
        "warning",
        "blocking"
      ],
      "title": "CritiqueSeverity",
      "type": "string"
    },
    "CritiqueStatus": {
      "enum": [
        "pass",
        "revise",
        "needs_human_review",
        "reject"
      ],
      "title": "CritiqueStatus",
      "type": "string"
    },
    "CulturalHypothesis": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/PublicReference"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "hypothesis_id": {
          "format": "uuid",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "review_status": {
          "default": "pending",
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "target_market": {
          "$ref": "#/$defs/Market"
        },
        "uncertainty": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Uncertainty",
          "type": "string"
