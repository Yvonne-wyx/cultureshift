          "type": "array"
        }
      },
      "required": [
        "hypothesis_id",
        "target_market",
        "claim",
        "evidence_refs",
        "uncertainty",
        "rationale",
        "validation_requirements"
      ],
      "title": "CulturalHypothesis",
      "type": "object"
    },
