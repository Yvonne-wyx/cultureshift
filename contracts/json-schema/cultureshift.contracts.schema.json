{
  "$defs": {
    "AdAnalysis": {
      "additionalProperties": false,
      "properties": {
        "brand_lock": {
          "$ref": "#/$defs/BrandLock"
        },
        "detected_locale": {
          "$ref": "#/$defs/Locale"
        },
        "hypotheses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CulturalHypothesis"
          },
          "maxItems": 32,
          "title": "Hypotheses",
          "type": "array"
        },
        "source_asset": {
          "$ref": "#/$defs/SourceAdAssetRef"
        },
        "warnings": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source_asset",
        "detected_locale",
        "brand_lock"
      ],
      "title": "AdAnalysis",
      "type": "object"
    },
    "AdCopy": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "cta_action_meaning": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Cta Action Meaning",
          "type": "string"
        },
        "cta_label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Cta Label",
          "type": "string"
        },
        "headline": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "locale": {
          "$ref": "#/$defs/Locale"
        }
      },
      "required": [
        "locale",
        "headline",
        "body",
        "cta_label",
        "cta_action_meaning"
      ],
      "title": "AdCopy",
      "type": "object"
    },
    "AnalysisCompleted": {
      "additionalProperties": false,
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AdAnalysis"
        },
        "completed_at": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "repair_attempted": {
          "title": "Repair Attempted",
          "type": "boolean"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "const": "awaiting_brand_lock",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "status",
        "analysis",
        "repair_attempted",
        "completed_at"
      ],
      "title": "AnalysisCompleted",
      "type": "object"
    },
    "AssetKind": {
      "enum": [
        "source_ad",
        "logo",
        "product_ui",
        "layout_template",
        "background",
        "rendered_ad"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcDatetime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "media_type": {
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$",
          "title": "Media Type",
          "type": "string"
        },
        "provenance_ref": {
          "$ref": "#/$defs/PublicReference"
        },
        "rights_ref": {
          "$ref": "#/$defs/PublicReference"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "media_type",
        "sha256",
        "provenance_ref",
        "rights_ref"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "AssetUploaded": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "$ref": "#/$defs/SourceAdAssetRef"
        },
        "created_at": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "delete_capability_token": {
          "maxLength": 4096,
          "minLength": 16,
          "title": "Delete Capability Token",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 10485760,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "asset",
        "size_bytes",
        "created_at",
        "delete_capability_token"
      ],
      "title": "AssetUploaded",
      "type": "object"
    },
    "BackgroundRequest": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/LocalizationDirection"
        },
        "height": {
          "const": 900,
          "default": 900,
          "title": "Height",
          "type": "integer"
        },
        "narrative": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Narrative",
          "type": "string"
        },
        "prohibited_content": {
          "default": [
            "logo",
            "brand_name",
            "product_ui",
            "statistics",
            "claims",
            "long_text"
          ],
          "items": {
            "enum": [
              "logo",
              "brand_name",
              "product_ui",
              "statistics",
              "claims",
              "long_text"
            ],
            "type": "string"
          },
          "title": "Prohibited Content",
          "type": "array"
        },
        "target_locale": {
          "$ref": "#/$defs/Locale"
        },
        "use_scenario": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Use Scenario",
          "type": "string"
        },
        "width": {
          "const": 1600,
          "default": 1600,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "direction",
        "target_locale",
        "narrative",
        "use_scenario"
      ],
      "title": "BackgroundRequest",
      "type": "object"
    },
    "BrandLock": {
      "additionalProperties": false,
      "properties": {
        "benefit_order": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Benefit Order",
          "type": "array"
        },
        "cta_action_meaning": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Cta Action Meaning",
          "type": "string"
        },
        "layout_template_asset_id": {
          "format": "uuid",
          "title": "Layout Template Asset Id",
          "type": "string"
        },
        "localizable_fields": {
          "items": {
            "enum": [
              "narrative",
              "use_scenario",
              "trust_information",
              "language"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Localizable Fields",
          "type": "array"
        },
        "logo_asset_id": {
          "format": "uuid",
          "title": "Logo Asset Id",
          "type": "string"
        },
        "product_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Product Name",
          "type": "string"
        },
        "product_ui_asset_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Product Ui Asset Ids",
          "type": "array"
        },
        "verified_product_facts": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Verified Product Facts",
          "type": "array"
        }
      },
      "required": [
        "logo_asset_id",
        "product_name",
        "verified_product_facts",
        "product_ui_asset_ids",
        "benefit_order",
        "cta_action_meaning",
        "layout_template_asset_id",
        "localizable_fields"
      ],
      "title": "BrandLock",
      "type": "object"
    },
    "BrandLockConfirmation": {
      "additionalProperties": false,
      "properties": {
        "brand_lock": {
          "$ref": "#/$defs/BrandLock"
        }
      },
      "required": [
        "brand_lock"
      ],
      "title": "BrandLockConfirmation",
      "type": "object"
    },
    "BrandLockConfirmed": {
      "additionalProperties": false,
      "properties": {
        "brand_lock": {
          "$ref": "#/$defs/BrandLock"
        },
        "confirmed_at": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "const": "in_progress",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "status",
        "brand_lock",
        "confirmed_at"
      ],
      "title": "BrandLockConfirmed",
      "type": "object"
    },
    "CompositionGenerated": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "disclosure": {
          "const": "Fixture Demo / 非实时模型",
          "title": "Disclosure",
          "type": "string"
        },
        "execution_mode": {
          "const": "fixture",
          "title": "FixtureCompositionExecutionMode",
          "type": "string"
        },
        "generated_at": {
          "$ref": "#/$defs/UtcDatetime"
        },
        "height": {
          "const": 900,
          "title": "Height",
          "type": "integer"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/CompositionLayer"
          },
          "maxItems": 7,
          "minItems": 6,
          "title": "Layers",
          "type": "array"
        },
        "media_type": {
          "const": "image/png",
          "title": "Media Type",
          "type": "string"
        },
        "rendered_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rendered Sha256",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "const": "in_progress",
          "title": "Status",
          "type": "string"
        },
        "width": {
          "const": 1600,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "status",
        "execution_mode",
        "width",
        "height",
        "media_type",
        "rendered_sha256",
        "artifact_id",
        "layers",
        "disclosure",
        "generated_at"
      ],
      "title": "CompositionGenerated",
      "type": "object"
    },
    "CompositionLayer": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Bounds",
          "type": "array"
        },
        "height": {
          "maximum": 900,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "background",
            "product_ui",
            "logo",
            "headline",
            "body",
            "cta",
            "disclosure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rgba_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Rgba Sha256",
          "type": "string"
        },
        "source_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Asset Id"
        },
        "width": {
          "maximum": 1600,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "rgba_sha256",
        "bounds",
        "width",
        "height"
      ],
      "title": "CompositionLayer",
      "type": "object"
    },
    "CreativeBrief": {
      "additionalProperties": false,
      "properties": {
        "brand_lock": {
          "$ref": "#/$defs/BrandLock"
        },
        "direction": {
          "$ref": "#/$defs/LocalizationDirection"
        },
        "hypotheses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CulturalHypothesis"
          },
          "maxItems": 32,
          "title": "Hypotheses",
          "type": "array"
        },
        "narrative": {
          "maxLength": 4000,
          "minLength": 1,
