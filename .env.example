# Copy to .env for local development. Never commit the populated file.

# Required by the FastAPI capability boundary. Use at least 32 UTF-8 bytes.
CULTURESHIFT_CAPABILITY_SECRET=

# Local development may keep using SQLite and temporary filesystem storage.
CULTURESHIFT_SQLITE_PATH=.cultureshift/runs.sqlite3
CULTURESHIFT_TEMP_ASSET_DIR=.cultureshift/assets

# Production persistence. Vercel Marketplace can inject the provider connection URL.
CULTURESHIFT_DATABASE_URL=
CULTURESHIFT_OBJECT_STORAGE_URL=
CULTURESHIFT_OBJECT_STORAGE_KEY=
CULTURESHIFT_OBJECT_STORAGE_BUCKET=cultureshift-private

# Optional only when the frontend and API are deployed on different origins.
NEXT_PUBLIC_CULTURESHIFT_API_URL=
CULTURESHIFT_STUDIO_ORIGINS=http://127.0.0.1:3000
